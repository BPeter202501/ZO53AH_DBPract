{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C: build (gcc)",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-Wall",
        "-Wextra",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "C: run (build+run)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "gcc \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\"; & \"${fileDirname}\\${fileBasenameNoExtension}.exe\""
      ],
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}